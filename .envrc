export DIRENV_WARN_TIMEOUT=20s

eval "$(devenv direnvrc)"

if [ -x ./scripts/sync-devenv-task-shims.sh ]; then
  ./scripts/sync-devenv-task-shims.sh >/dev/null 2>&1 || true
fi

PATH_add .devenv/task-shims
dotenv_if_exists .env
source_env_if_exists .workonrc

# The use_devenv function supports passing flags to the devenv command
# For example: use devenv --impure --option services.postgres.enable:bool true
if [ "${USE_DEVENV:-0}" = "1" ]; then
  if ! use devenv; then
    echo "direnv: full devenv loading failed, continuing with task-shim mode."
  fi
else
  echo "direnv: task-shim mode active. Run 'export USE_DEVENV=1; direnv reload' for the full devenv shell experience."
fi
