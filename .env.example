# Dummy secrets for CI/CD pipeline
# These are placeholder values to satisfy SecretSpec requirements in CI
# Real secrets are stored in GCP Secret Manager for production deployments

# Backend configuration (override as needed per environment)
CACHET_ENV=ci
CACHET_CONFIG_PATH=
CACHET_DB_URL=postgresql://dummy:dummy@localhost/dummy
CACHET_JWT_SECRET=dummy-jwt-secret-for-ci-testing-only

# Veriff Integration
# Local development defaults to the sandbox integration
VERIFF_ENVIRONMENT=test

# Sandbox credentials (override with `pass` or SecretSpec profiles as needed)
VERIFF_TEST_API_KEY=dummy-sandbox-api-key-for-ci
VERIFF_TEST_WEBHOOK_SECRET=dummy-sandbox-webhook-secret-for-ci

# Production credentials (only populated in secured environments)
VERIFF_PROD_API_KEY=
VERIFF_PROD_WEBHOOK_SECRET=

# Optional overrides
VERIFF_BASE_URL=https://stationapi.veriff.com
VERIFF_WEBHOOK_EXTERNAL_URL=
