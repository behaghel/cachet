CREATE TABLE credentials (
    local_id TEXT PRIMARY KEY NOT NULL,
    credential_id TEXT NOT NULL,
    issuer TEXT NOT NULL,
    credential_json TEXT NOT NULL,
    raw_jwt TEXT,
    created_at INTEGER NOT NULL,
    is_revoked INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX idx_credentials_issuer ON credentials(issuer);
CREATE INDEX idx_credentials_created ON credentials(created_at);

insertCredential:
INSERT INTO credentials (local_id, credential_id, issuer, credential_json, raw_jwt, created_at, is_revoked)
VALUES (?, ?, ?, ?, ?, ?, ?);

getAllCredentials:
SELECT * FROM credentials ORDER BY created_at DESC;

getCredentialById:
SELECT * FROM credentials WHERE local_id = ?;

getCredentialsByIssuer:
SELECT * FROM credentials WHERE issuer = ? ORDER BY created_at DESC;

markCredentialRevoked:
UPDATE credentials SET is_revoked = 1 WHERE local_id = ?;

deleteCredential:
DELETE FROM credentials WHERE local_id = ?;

-- Consent receipts
CREATE TABLE consent_receipts (
    id TEXT PRIMARY KEY NOT NULL,
    timestamp INTEGER NOT NULL,
    purpose TEXT NOT NULL,
    predicates_json TEXT NOT NULL,
    rp_identifier TEXT NOT NULL,
    rp_display_name TEXT NOT NULL,
    consent_json TEXT NOT NULL,
    credential_id TEXT NOT NULL,
    receipt_hash TEXT,
    signature TEXT,
    salt TEXT,
    transparency_log_json TEXT
);

CREATE INDEX idx_receipts_rp ON consent_receipts(rp_identifier);
CREATE INDEX idx_receipts_credential ON consent_receipts(credential_id);
CREATE INDEX idx_receipts_timestamp ON consent_receipts(timestamp);

insertReceipt:
INSERT INTO consent_receipts (id, timestamp, purpose, predicates_json, rp_identifier, rp_display_name, consent_json, credential_id, receipt_hash, signature, salt, transparency_log_json)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getReceiptById:
SELECT * FROM consent_receipts WHERE id = ?;

getAllReceipts:
SELECT * FROM consent_receipts ORDER BY timestamp DESC;

getReceiptsByRP:
SELECT * FROM consent_receipts WHERE rp_identifier = ? ORDER BY timestamp DESC;

getReceiptsByCredential:
SELECT * FROM consent_receipts WHERE credential_id = ? ORDER BY timestamp DESC;

deleteReceipt:
DELETE FROM consent_receipts WHERE id = ?;