# Dummy secrets for CI/CD pipeline
# These are placeholder values to satisfy SecretSpec requirements in CI
# Real secrets are stored in GCP Secret Manager for production deployments

CACHET_ENV="ci"
CACHET_CONFIG_PATH="${PWD}/config/app-config.json"
CACHET_DB_URL="postgresql://dummy:dummy@localhost/dummy"
CACHET_JWT_SECRET="dummy-jwt-secret-for-ci-testing-only"

# Veriff Integration (Test Environment)
# For local development, these should be populated from `pass`:
# VERIFF_API_KEY=$(pass veriff/cachet-api-key)
# VERIFF_WEBHOOK_SECRET=$(pass veriff/cachet-sig-key)
VERIFF_API_KEY=dummy-veriff-api-key-for-ci
VERIFF_BASE_URL=https://stationapi.veriff.com
VERIFF_WEBHOOK_SECRET="dummy-veriff-webhook-secret-for-ci"
VERIFF_WEBHOOK_BASE_URL="http://localhost:8082"
