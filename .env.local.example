# Local development environment with real secrets from `pass`
# Copy this to .env if you want to populate values dynamically via pass

# Database and JWT (keep dummy values for local development)
CACHET_DB_URL="postgresql://dummy:dummy@localhost/dummy"
CACHET_JWT_SECRET="dummy-jwt-secret-for-ci-testing-only"

# Veriff Integration - Real credentials from `pass`
# These will enable actual Veriff SDK integration
VERIFF_API_KEY="$(pass veriff/cachet-api-key 2>/dev/null || echo 'dummy-veriff-api-key-for-ci')"
VERIFF_BASE_URL="https://stationapi.veriff.com"
VERIFF_WEBHOOK_SECRET="$(pass veriff/cachet-sig-key 2>/dev/null || echo 'dummy-veriff-webhook-secret-for-ci')"
VERIFF_WEBHOOK_BASE_URL="http://localhost:8082"

# Note: The $(pass ...) commands will:
# - Use real credentials if available in your pass store
# - Fall back to dummy values if pass entries don't exist
# - Never expose credentials in error messages due to 2>/dev/null
